# Sigenergy API credentials.
# This file lives outside www/ and must not be web-accessible.
# Replace the values below with your own.

SIGEN_APP_KEY=
SIGEN_APP_SECRET=
SIGEN_SYSTEM_ID=
SIGEN_REGION=eu
SIGEN_LANGUAGE=sv

# Authentication mode: key or password.
SIGEN_AUTH_TYPE=key

# Used only when SIGEN_AUTH_TYPE=password.
SIGEN_USERNAME=
SIGEN_PASSWORD=
SIGEN_PASSWORD_LOGIN_PATH=/openapi/auth/login/password

# Used for runtime estimates. Set this to installed battery capacity in kWh.
SIGEN_BATTERY_CAPACITY_KWH=27

# Minimum battery level that should not count as usable energy.
SIGEN_BATTERY_RESERVE_PERCENT=10

# Electricity price settings
TIBBER_API_KEY=
TIBBER_HOME_INDEX=0
PRICE_BREAKPOINT_VERY_EXPENSIVE=3.0
PRICE_BREAKPOINT_EXPENSIVE=2.0
PRICE_BREAKPOINT_OK=1.0
PRICE_BREAKPOINT_CHEAP=0.5

# Wiz price light settings
WIZ_ENABLED=0
WIZ_HOSTNAME=
WIZ_FALLBACK_IP=
WIZ_BRIGHTNESS=100
WIZ_MAX_PRICE_AGE_MINUTES=180
